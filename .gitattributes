# Explicit language mapping for GitHub's language bar.
# Extensions are mapped narrowly so CSS/HTML assets are not misclassified.
desktop/backend/*.py linguist-language=Python
desktop/frontend/src/*.ts linguist-language=TypeScript
desktop/frontend/src/*.tsx linguist-language=TypeScript
desktop/frontend/src/**/*.ts linguist-language=TypeScript
desktop/frontend/src/**/*.tsx linguist-language=TypeScript
desktop/frontend/src/*.css linguist-language=CSS
desktop/frontend/src/*.html linguist-language=HTML
ios/StockDesk/**/*.swift linguist-language=Swift
us/*.py linguist-language=Python
us/static/*.js linguist-language=JavaScript
us/static/*.css linguist-language=CSS
us/static/*.html linguist-language=HTML

# Third-party bundles should not dominate the stats
desktop/frontend/public/vendor/* linguist-vendored
us/static/echarts.min.js linguist-vendored
