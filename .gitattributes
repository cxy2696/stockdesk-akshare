# Let GitHub recognize the main languages explicitly
*.py linguist-language=Python linguist-detectable=true
*.ts linguist-language=TypeScript linguist-detectable=true
*.tsx linguist-language=TypeScript linguist-detectable=true
*.swift linguist-language=Swift linguist-detectable=true
*.js linguist-language=JavaScript linguist-detectable=true
*.css linguist-language=CSS linguist-detectable=true
*.html linguist-language=HTML linguist-detectable=true

# Third-party bundles are not project source
desktop/frontend/public/vendor/* linguist-vendored
us/static/echarts.min.js linguist-vendored

# Screenshots and binaries
*.png binary
*.jpg binary
*.webp binary
*.ipa binary
*.exe binary
